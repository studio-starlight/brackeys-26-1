metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_mipxw"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("15_y13qf")
text = "I see my confession left you unfazed."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_6gm6o"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "I must say that I am quite hurt."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_afrn4"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "I know what I said, but I'd still like you to be at least a little flustered."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_uabtn"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("15_y13qf")
text = "... Childish? I am most certainly not!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_tmsq8"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("15_y13qf")
text = "Well if you plan to be mean to me then I have no choice but to be mean to you!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_egbg8"]
