[sub_resource type="Resource" id="Resource_rfqhp"]
script = ExtResource("7_ht0kt")
animation_name = "beginning"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_uy6f3"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_enter"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_ahqd5"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "Oh wonderful! You're awake! I honestly didn't think that'd work"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_dw2ve"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "Greetings, my name is Cane. "
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_2j1fn"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "You may recognize my face but we've never been able to talk haven't we?"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_y13qf"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "I've wanted to know for quite a while now but, what is your name?"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_p2x0k"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "... Candy? What a lovely name!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_b2sh1"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "I know you must be confused, but simply know that all I seek is to help you."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_bpyde"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "I know you are struggling right now..."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_1qpl0"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "So I hope to take some of the burden of your shoulders by providing a way for you to have fun!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_t61ei"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "Candy! This arena was constructed just for you, a simple place where you can have fun."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_wmjq7"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "So, won't you play? "
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_2m0yh"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "... Excellent! Now, let's begin!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_ht0kt"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_exit"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

