metadata/_custom_type_script = "uid://vd74rdt82yon"

[sub_resource type="Resource" id="Resource_l1e6r"]
script = ExtResource("7_ht0kt")
animation_name = "beginning"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_i0w65"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_enter"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_xdwyp"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "Amazing, you're already a master at this!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_e8oij"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "Oh, and I see you've gotten yourself a nice treat!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_gjv6m"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "There are several you can get, though to be honest, I don't know where they come from."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_byuhv"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "Then again, I don't know much in general..."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_au6tn"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "Anywho, let's start the next round!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_i0cc4"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_exit"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_gqwak"]
script = ExtResource("3_q2try")
cutscene_data = Array[ExtResource("3_c11q5")]([SubResource("Resource_l1e6r"), SubResource("Resource_i0w65"), SubResource("Resource_xdwyp"), SubResource("Resource_e8oij"), SubResource("Resource_gjv6m"), SubResource("Resource_byuhv"), SubResource("Resource_au6tn"), SubResource("Resource_i0cc4")])
metadata/_custom_type_script = "uid://vd74rdt82yon"

[sub_resource type="Resource" id="Resource_5cr7e"]
script = ExtResource("7_ht0kt")
animation_name = "beginning"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_j2lwl"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_enter"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_07xg1"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "My Dear Candy, I do hope this is fun for you."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_aatd7"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "To be quite honest, I am a bit too delicate to participate myself."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_omdyk"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "That and I don't really find this sort of thing fun, but don't worry!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_q1sma"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "All who are here today were willful volunteers!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_tj3wl"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "What's that? What Happens when they poof?"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_oatcm"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "You've never poofed before, Candy?"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_5p0b8"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "How strange the world you come from is!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_ipm04"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_exit"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_quh40"]
script = ExtResource("3_q2try")
cutscene_data = Array[ExtResource("3_c11q5")]([SubResource("Resource_5cr7e"), SubResource("Resource_j2lwl"), SubResource("Resource_07xg1"), SubResource("Resource_aatd7"), SubResource("Resource_omdyk"), SubResource("Resource_q1sma"), SubResource("Resource_tj3wl"), SubResource("Resource_oatcm"), SubResource("Resource_5p0b8"), SubResource("Resource_ipm04")])
metadata/_custom_type_script = "uid://vd74rdt82yon"

[sub_resource type="Resource" id="Resource_qgnwo"]
script = ExtResource("7_ht0kt")
animation_name = "beginning"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_rggdo"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_enter"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_it6ed"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "I feel the need to explain a few things."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_ebxoj"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "I'm certain you recognize this world from your dreams, correct?"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_d3bhf"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("10_y13qf")
text = "I guess it's not known in your world but in mine, dreams are known to swap the place of two connected dreamers."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_t1jwb"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "Upon returning, however, it becomes hard to truly recall what happened, only small parts."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_t6653"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "I guess it makes sense that you didn't know. Afterall, the scene everytime I returned always looked..."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_fpscu"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "Ah, I've talked for too long, let's get to the next round!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_jkjum"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_exit"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_a4aho"]
script = ExtResource("3_q2try")
cutscene_data = Array[ExtResource("3_c11q5")]([SubResource("Resource_qgnwo"), SubResource("Resource_rggdo"), SubResource("Resource_it6ed"), SubResource("Resource_ebxoj"), SubResource("Resource_d3bhf"), SubResource("Resource_t1jwb"), SubResource("Resource_t6653"), SubResource("Resource_fpscu"), SubResource("Resource_jkjum")])
metadata/_custom_type_script = "uid://vd74rdt82yon"

[sub_resource type="Resource" id="Resource_1r5l7"]
script = ExtResource("7_ht0kt")
animation_name = "beginning"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_4yjk5"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_enter"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_gvv8i"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "Candy, I hope that this has been a delightful respite."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_v8b7j"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "I never got to see it fully, but I can tell the world you live in is one full of hardship."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_yqusv"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("11_p2x0k")
text = "And yet... Why am I so drawn to it?"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_jlage"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("15_y13qf")
text = "... I suppose I know why."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_a1ntb"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("9_2j1fn")
text = "Pardon, you want to know why? Well then get past this round first!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_e7tf0"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_exit"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_0yyd6"]
script = ExtResource("3_q2try")
cutscene_data = Array[ExtResource("3_c11q5")]([SubResource("Resource_1r5l7"), SubResource("Resource_4yjk5"), SubResource("Resource_gvv8i"), SubResource("Resource_v8b7j"), SubResource("Resource_yqusv"), SubResource("Resource_jlage"), SubResource("Resource_a1ntb"), SubResource("Resource_e7tf0")])
metadata/_custom_type_script = "uid://vd74rdt82yon"

[sub_resource type="Resource" id="Resource_jx57b"]
script = ExtResource("7_ht0kt")
animation_name = "beginning"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_x8ktg"]
script = ExtResource("7_ht0kt")
animation_name = "cane_poof_enter"
hide_dialogue_box = true
wait_for_animation_finished = true
metadata/_custom_type_script = "uid://csb4hvs2xwugx"

[sub_resource type="Resource" id="Resource_hwkwu"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("8_t7urq")
speaker_img_Hframes = 2
speaker_img_rest_frame = 1
text = "Wow, you really pushed hard to get my answer didn't you?"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_d40hk"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("8_t7urq")
speaker_img_Hframes = 2
speaker_img_rest_frame = 1
text = "Well... coming to your world, I always saw, broken things."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_yhut4"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("8_t7urq")
speaker_img_Hframes = 2
speaker_img_rest_frame = 1
text = "Toys, Windows, Walls... Yet, I began to learn more. More about you."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_eecqd"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("8_t7urq")
speaker_img_Hframes = 2
speaker_img_rest_frame = 1
text = "And the more about you I learned, the more my heart began to race."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_4kv03"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("8_t7urq")
speaker_img_Hframes = 2
speaker_img_rest_frame = 1
text = "I understand that I am naive, but I feel like I understand why I feel like that."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_7xpab"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("8_t7urq")
speaker_img_Hframes = 2
speaker_img_rest_frame = 1
text = "Fret not, However! I will nost ask you to return such feelings."
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

[sub_resource type="Resource" id="Resource_qrsv2"]
script = ExtResource("7_xdwyp")
speaker_img = ExtResource("8_t7urq")
speaker_img_Hframes = 2
speaker_img_rest_frame = 1
text = "Simply know that I will do whatever it takes to make you happy!"
metadata/_custom_type_script = "uid://dg44yqyt36m2x"

